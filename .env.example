# Predator Guard - environment template.
#
# Copy it to .env.local in the repository root:
#   Copy-Item .env.example .env.local
# apps/web/next.config.mjs loads that root file explicitly, because Next on its
# own only reads env files from the app directory.
# NEVER put real keys in this file - it is tracked in git.

# ---- Vision model (what identifies the animal) ----
# The primary classifier: one key, one call per frame.
# Get a key at https://openrouter.ai/keys - unset => the app runs but the
# analyze endpoint answers 503 with setup instructions.
# OPENROUTER_API_KEY=replace-with-your-openrouter-token
# OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- AWS Bedrock (fallback, tried when OpenRouter is not configured) ----
# Standard AWS credentials apply (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# or a profile); region falls back to us-east-1.
# BEDROCK_MODEL_ID=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Database ----
# Postgres connection string. Omitted (or empty) => embedded PGlite (real
# Postgres compiled to WASM), so `npm run dev` needs no services at all.
# For a real server:  docker compose up -d db  and then
# DATABASE_URL=postgres://predator_guard:predator_guard@localhost:5432/predator_guard
# Neon PostgreSQL connection URI (safe template; replace <NEON_PASSWORD> locally/Vercel).
# Database: predator | Branch: production | SSL is required.
# DATABASE_URL=postgresql://neondb_owner:<NEON_PASSWORD>@ep-dark-night-b5nwrdd6-pooler.c-7.us-east-2.aws.neon.tech/predator?channel_binding=require&sslmode=require
# Where PGlite keeps its data directory (default: .pglite, gitignored).
# PGLITE_DATA_DIR=.pglite

# ---- Object storage (uploaded media + captured frames) ----
# The file the user picked (photo or video) and the analysed frame are kept in
# the S3-compatible bucket; the database holds only the object key
# (uploads/<id>.<ext>, captures/<id>.jpg). The browser asks /api/media/<id> or
# /api/captures/<id>, which hand it a short-lived signed link. Without these the
# app still works - files are analysed and saved, they are just not stored.
# The endpoint of the S3-compatible provider (required unless you really use
# AWS S3). Paste the value without quotes: a hosting dashboard keeps
# `"https://…"` verbatim and the SDK then answers `Invalid URL`.
# AWS_ENDPOINT_URL_S3=https://your-provider.example.com
# Bucket that holds the files (default: aws-demo). It must already exist - the
# app never creates buckets. Check the provider console for its real name.
# AWS_S3_BUCKET=aws-demo
# The AWS credentials above (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_REGION) are the same ones the bucket is opened with.
# Path-style addressing is the safe default for a custom endpoint; set it to
# false only when the provider requires virtual-hosted style.
# AWS_S3_FORCE_PATH_STYLE=true

# ---- Emergency contact (left sidebar) ----
# Your own number for a predator alert; no number is invented.
# EMERGENCY_CONTACT_NAME=Farm manager
# EMERGENCY_CONTACT_PHONE=+1-555-0100

# The current schema creates: farm_profile, cameras, detections, region_watchlist, media_uploads, schema_migrations.
# Do not add credentials to this tracked file.
