# Predator Guard - environment template.
# Copy it to .env.local in the repository root:
# NEVER put real keys in this file - it is tracked in git.

# OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Ring Appstore Knowledge MCP gateway. Optional override; the default is read
# from mcp.json at the repository root.
# RING_MCP_URL=https://knowledge.appstore-mcp.ring.amazon.dev/mcp

# Ring Partner API - powers the live dashboard section (devices, live view,
# event history, snapshots). Paste a fresh OAuth token from the Dev Portal;
# it lives about 4 hours. The API base only needs overriding for staging.
# RING_ACCESS_TOKEN=
# RING_API_BASE=https://api.amazonvision.com

# EMERGENCY_CONTACT_NAME=Farm manager
# EMERGENCY_CONTACT_PHONE=+1-555-0100
# DATABASE_URL=postgresql://neondb_owner:<NEON_PASSWORD>@ep-dark-night-b5nwrdd6-pooler.c-7.us-east-2.aws.neon.tech/predator?channel_binding=require&sslmode=require

# The current schema creates: farm_profile, cameras, detections, region_watchlist, media_uploads, schema_migrations.
