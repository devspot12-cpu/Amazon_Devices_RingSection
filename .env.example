# Copy to apps/web/.env.local. Never put real credentials in this tracked template.
# Without an OpenRouter key, the analyze endpoint returns 503 with setup instructions.
# OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=minimax/minimax-m3.1-flash:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Optional: unset DATABASE_URL uses embedded PGlite.
# DATABASE_URL=postgresql://predator_guard:predator_guard@localhost:5432/predator_guard
# PGLITE_DATA_DIR=.pglite
