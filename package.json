{
  "name": "predator-guard",
  "version": "0.0.0",
  "private": true,
  "description": "Predator Guard - a species-aware predator alarm built on the Ring Partner API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @predator-guard/web",
    "build": "npm run build --workspace @predator-guard/web",
    "start": "npm run start --workspace @predator-guard/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "storage:inspect": "node --env-file=.env.local scripts/storage-inspect.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
